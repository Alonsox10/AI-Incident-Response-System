# Plantilla de configuración. Copiar a `.env` y completar.
#
#     cp .env.example .env
#
# Este archivo SÍ se versiona y por eso no lleva ningún valor real: solo placeholders.
# `.env` está en `.gitignore` y en `.dockerignore`.

# ─── Obligatorias ─────────────────────────────────────────────────────────────

OPENAI_API_KEY=sk-reemplazar
POSTGRES_URL=postgresql://usuario:contrasena@localhost:5432/incident_ai

# Firma de la cookie de conversación. Generar uno propio:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# Con APP_ENTORNO=produccion es obligatoria y el arranque falla si falta: sin un valor
# fijo y compartido, cada reinicio invalida las cookies y cada réplica firma distinto.
SESSION_SECRET=

# ─── Credenciales de Postgres para docker-compose ─────────────────────────────
# Solo las usa el compose para levantar el contenedor y armar POSTGRES_URL.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=incident_ai

# ─── Entorno ──────────────────────────────────────────────────────────────────
# `produccion` activa el flag Secure de la cookie (exige HTTPS), vuelve obligatorio
# SESSION_SECRET y enciende la autenticacion. Cualquier otro valor es desarrollo.
APP_ENTORNO=desarrollo

# ─── Autenticacion ────────────────────────────────────────────────────────────
# APAGADA de fabrica: quien clone el repo arranca y prueba con un curl sin crear
# tenants ni mandar cabeceras. Apagada, toda peticion corre como un tenant anonimo con
# rol de admin, asi que /documents/ingest/pdf y /incidents/historical quedan abiertos.
#
# Encendida (true), cada peticion exige `X-API-Key` y las claves se emiten con
# `python scripts/gestionar_tenants.py crear <nombre>`.
#
# Con APP_ENTORNO=produccion el default se invierte a true, y pedir false ahi es un
# fallo de arranque: lo que escriben esos endpoints alimenta el RAG de todos.
AUTH_HABILITADA=false

# ─── Seguridad y límites (opcionales, con defaults razonables) ────────────────

# Orígenes permitidos para CORS, separados por coma. Vacío = ningún origen externo
# puede llamar a la API desde un navegador. Nunca `*`: con credenciales no es válido.
CORS_ORIGENES=

RATE_LIMIT_INCIDENTES=30/minute
RATE_LIMIT_INGESTA=5/minute

# Timeouts y reintentos contra OpenAI. Sin ellos se heredan los del SDK, cuyo timeout
# de request ronda los 10 minutos.
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
EMBEDDINGS_TIMEOUT=30
EMBEDDINGS_MAX_RETRIES=3

# Presupuesto total de un workflow. Los timeouts por llamada no acotan el conjunto.
GRAFO_PRESUPUESTO_SEGUNDOS=120

# ─── Base de datos y carga ────────────────────────────────────────────────────

POSTGRES_POOL_MAX=20
# Workers de uvicorn. Cada uno abre su propio pool: el total de conexiones a Postgres
# es POSTGRES_POOL_MAX × WEB_CONCURRENCY.
WEB_CONCURRENCY=2

# ─── Observabilidad ───────────────────────────────────────────────────────────

LOG_JSON=true
LOG_LEVEL=INFO
# Tarifas del contrato vigente, por millón de tokens. En 0 el costo no se calcula:
# una tarifa inventada produce un número que parece medido y no lo es.
LLM_COSTO_ENTRADA_POR_1M=0
LLM_COSTO_SALIDA_POR_1M=0

# ─── Umbrales del camino de FAQ ───────────────────────────────────────────────
# Separados a propósito. Ver la sección de arquitectura del CLAUDE.md antes de tocarlos.

FAQ_HIGH_CONFIDENCE_THRESHOLD=0.75
FAQ_ROUTING_THRESHOLD=0.85

# ─── Ingesta ──────────────────────────────────────────────────────────────────

MAX_PDF_MB=20
