OPENAI_API_KEY=sk-proj-tu-clave-aqui
POSTGRES_URL=postgresql://postgres:alonso@postgres:5432/incident_ai

# Umbral de similitud a partir del cual el agente de FAQs devuelve la respuesta
# almacenada tal cual, sin generarla con el LLM. Opcional, por defecto 0.75.
FAQ_HIGH_CONFIDENCE_THRESHOLD=0.75

# Umbral con que el orquestador enruta directo a FAQ sin consultar al LLM.
# Mas alto que el anterior a proposito: entre 0.75 y 0.85 caen los parafraseos de
# sintomas activos, que deben pasar por el criterio del orquestador. Por defecto 0.85.
FAQ_ROUTING_THRESHOLD=0.85
